<div class="modal-overlay @(isVisible ? "visible" : "")" @onclick="Cancel">
    <div class="modal-content" @onclick:stopPropagation>
        <div class="modal-icon">@Icon</div>
        <h3 class="modal-title">@Title</h3>
        <p class="modal-message">@Message</p>
        <div class="modal-actions">
            <button class="btn btn-secondary" @onclick="Cancel">@CancelText</button>
            <button class="btn btn-danger" @onclick="Confirm">@ConfirmText</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool isVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Konfirmasi";
    [Parameter] public string Message { get; set; } = "Yakin?";
    [Parameter] public string Icon { get; set; } = "⚠️";
    [Parameter] public string ConfirmText { get; set; } = "Ya";
    [Parameter] public string CancelText { get; set; } = "Batal";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirm() => await OnConfirm.InvokeAsync();
    private async Task Cancel() => await OnCancel.InvokeAsync();
}
