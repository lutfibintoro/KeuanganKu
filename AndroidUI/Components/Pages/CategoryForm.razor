@page "/settings/categories/add"
@page "/settings/categories/edit/{Id:int}"
@layout MainLayout

<div class="page">
    <div class="page-header">
        <h2>@(isEdit ? "Edit" : "Tambah") Kategori</h2>
    </div>

    <div class="form-card">
        <div class="form-group">
            <label>Tipe</label>
            <select class="form-select" @bind="model.Type" disabled="@isEdit" style="@(isEdit ? "opacity: 0.5;" : "")">
                <option value="Income">💵 Pemasukan</option>
                <option value="Expense">💳 Pengeluaran</option>
            </select>
        </div>

        <div class="form-group">
            <label>Nama Kategori</label>
            <input type="text" class="form-input" @bind="model.Name" placeholder="Nama kategori..." />
        </div>

        <div class="form-group">
            <label>Icon</label>
            <div class="icon-picker">
                @foreach (var icon in availableIcons)
                {
                    <button class="icon-option @(model.Icon == icon ? "selected" : "")"
                            @onclick='() => model.Icon = icon'>
                        @icon
                    </button>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Warna</label>
            <div class="color-picker">
                @foreach (var color in availableColors)
                {
                    <button class="color-option @(model.ColorHex == color ? "selected" : "")"
                            style="background:@color"
                            @onclick='() => model.ColorHex = color'>
                    </button>
                }
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="GoBack">Batal</button>
            <button class="btn btn-primary" @onclick="SaveAsync">Simpan</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private CategoryService categoryService { get; set; } = default!;
    [Inject] private NavigationManager nav { get; set; } = default!;
    [Inject] private IconService iconService { get; set; } = null!;
    [Inject] private ColorService colorService { get; set; } = null!;

    private Category model = new() { ColorHex = "#607D8B", Icon = "📄", Type = "Expense" };
    private bool isEdit;

    private string[] availableIcons = [];
    private string[] availableColors = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();

        isEdit = Id > 0;
        if (isEdit)
        {
            var existing = await categoryService.GetByIdAsync(Id);
            if (existing is not null)
                model = existing;
        }

        availableIcons = await iconService.GetAsync();
        availableColors = await colorService.GetAsync();
    }

    private void GoBack() => nav.NavigateTo("/settings/categories");

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Name)) return;
        await categoryService.SaveAsync(model);
        nav.NavigateTo("/settings/categories");
    }
}
