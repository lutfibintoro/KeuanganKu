@page "/settings/accounts/add"
@page "/settings/accounts/edit/{Id:int}"
@layout MainLayout

<div class="page">
	<div class="page-header">
		<h2>@(isEdit ? "Edit" : "Tambah") Akun</h2>
	</div>

	<div class="form-card">
		<div class="form-group">
			<label>Nama Akun</label>
			<input type="text" class="form-input" @bind="model.Name" placeholder="Nama akun..." />
		</div>

		<div class="form-group">
			<label>Tipe Akun</label>
			@if (model.Type != "Lainnya")
			{
				<div class="filter-bar">
					<select class="form-select" @bind="model.Type" disabled="@isEdit" style="@(isEdit ? "opacity: 0.5;" : "")width: 75%">
						@foreach (AccountType type in availableAccountTypes)
						{
							<option value="@(type.Name)">@(type.Name)</option>
						}
						<option value="Lainnya">Lainnya...</option>
					</select>
					<button class="btn btn-secondary" style="width: 25%" @onclick='DeleteTypeAsync'>Hapus</button>
				</div>
			}
			else
			{
				<div class="filter-bar">
					<input placeholder="Tipe akun..." @bind="tipeAkunNewOption" type="text" class="form-input" style="width:60%" />
					<button class="btn btn-secondary" style="width: 20%" @onclick='SaveTypeAsync'>Save</button>
					<button class="btn btn-secondary" style="width: 20%" @onclick='SetType'>Batal</button>
				</div>
			}
		</div>

		<div class="form-group">
			<label>Saldo @(isEdit ? "" : "Awal")@(decimal.TryParse(balanceStr, out decimal amount) ? $": {FormatRupiah(amount)}" : "")</label>
			<div class="input-amount-wrapper">
				<span class="currency-prefix">Rp</span>
				<input type="number" class="form-input input-amount" @bind="balanceStr" @bind:event="oninput"
					   placeholder="0" step="1000" disabled="@isEdit" style="@(isEdit ? "opacity: 0.5;" : "")" />
			</div>
		</div>

		<div class="form-group">
			<label>Icon</label>
			<div class="icon-picker">
				@foreach (var icon in availableIcons)
				{
					<button class="icon-option @(model.Icon == icon ? "selected" : "")"
							@onclick='() => model.Icon = icon'>
						@icon
					</button>
				}
			</div>
		</div>

		<div class="form-group">
			<label>Warna</label>
			<div class="color-picker">
				@foreach (var color in availableColors)
				{
					<button class="color-option @(model.ColorHex == color ? "selected" : "")"
							style="background:@color"
							@onclick='() => model.ColorHex = color'>
					</button>
				}
			</div>
		</div>

		<div class="form-actions">
			<button class="btn btn-secondary" @onclick="GoBack">Batal</button>
			<button class="btn btn-primary" @onclick="SaveAsync">Simpan</button>
		</div>
	</div>
</div>

@code {
	[Parameter] public int Id { get; set; }

	[Inject] private AccountService accountService { get; set; } = default!;
	[Inject] private NavigationManager nav { get; set; } = default!;
	[Inject] private IconService iconService { get; set; } = null!;
	[Inject] private ColorService colorService { get; set; } = null!;
	[Inject] private AccountTypeService accountTypeService { get; set; } = null!;

	private Account model = new();
	private bool isEdit;
	private string balanceStr = "0";

	private string[] availableIcons = [];
	private string[] availableColors = [];
	private AccountType[] availableAccountTypes = [];

	private string tipeAkunNewOption = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		await Task.Yield();

		isEdit = Id > 0;
		if (isEdit)
		{
			var existing = await accountService.GetByIdAsync(Id);
			if (existing is not null)
			{
				model = existing;
				balanceStr = model.Balance.ToString("F0");
			}
		}

		availableIcons = await iconService.GetAsync();
		availableColors = await colorService.GetAsync();
		availableAccountTypes = await accountTypeService.GetAllAccountTypeAsync();

		SetType();
	}

	private void GoBack() => nav.NavigateTo("/settings/accounts");

	private void SetType()
	{
		if (availableAccountTypes.Length > 0)
			model.Type = availableAccountTypes[0].Name;
		else
			model.Type = "Lainnya";
	}

	private async Task SaveAsync()
	{
		if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrEmpty(model.Name) ||
			string.IsNullOrWhiteSpace(model.Icon) || string.IsNullOrEmpty(model.Icon) ||
			string.IsNullOrWhiteSpace(model.Type) || string.IsNullOrEmpty(model.Type) ||
			string.IsNullOrWhiteSpace(model.ColorHex) || string.IsNullOrEmpty(model.ColorHex))
			return;

		if (!isEdit && decimal.TryParse(balanceStr, out var bal))
		{
			model.Balance = bal;
			model.InitialBalance = bal;
		}

		await accountService.SaveAsync(model);
		nav.NavigateTo("/settings/accounts");
	}

	private async Task SaveTypeAsync()
	{
		if (string.IsNullOrEmpty(tipeAkunNewOption) || string.IsNullOrWhiteSpace(tipeAkunNewOption))
			return;

		AccountType accountType = new()
		{
			Name = tipeAkunNewOption
		};
		await accountTypeService.SaveAsync(accountType);
		availableAccountTypes = await accountTypeService.GetAllAccountTypeAsync();
		model.Type = tipeAkunNewOption;
		tipeAkunNewOption = string.Empty;
	}

	private async Task DeleteTypeAsync()
	{
		AccountType? accountType = availableAccountTypes.Where(acctyp => acctyp.Name == model.Type).FirstOrDefault();
		if (accountType is null)
			return;

		await accountTypeService.DeleteAsync(accountType);
		availableAccountTypes = await accountTypeService.GetAllAccountTypeAsync();

		SetType();
	}

	private string FormatRupiah(decimal amount) => $"Rp{amount:N0}";
}