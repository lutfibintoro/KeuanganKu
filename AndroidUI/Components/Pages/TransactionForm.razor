@page "/transactions/add/{Type}"
@page "/transactions/edit/{Id:int}"
@layout MainLayout

<div class="page">
	<div class="page-header">
		<h2>@(isEdit ? "Edit" : "Tambah") Transaksi</h2>
	</div>

	<div class="form-card">
		<div class="form-group">
			<label>Tipe</label>
			<div class="type-toggle">
				<button class="toggle-btn @(model.Type == "Income" ? "active-income" : "")" @onclick='() => SetType("Income")'>💵 Pemasukan</button>
				<button class="toggle-btn @(model.Type == "Expense" ? "active-expense" : "")" @onclick='() => SetType("Expense")'>💳 Pengeluaran</button>
			</div>
		</div>

		<div class="form-group">
			<label>Jumlah@(decimal.TryParse(inputAmount, out decimal amount) ? $": {FormatRupiah(amount)}" : "")</label>
			<div class="input-amount-wrapper">
				<span class="currency-prefix">Rp</span>
				<input type="number" class="form-input input-amount" @bind="inputAmount" @bind:event="oninput"
					   placeholder="0" step="500" />
			</div>
		</div>

		<div class="form-group">
			<label>Kategori</label>
			<select class="form-select" @bind="model.CategoryId" @bind:event="oninput">
				<option value="">Pilih kategori...</option>
				@foreach (var cat in categories)
				{
					<option value="@cat.Id">@cat.Icon @cat.Name</option>
				}
			</select>
		</div>

		<div class="form-group">
			<label>Akun</label>
			<select class="form-select" @bind="model.AccountId">
				<option value="0">Pilih akun...</option>
				@foreach (var acc in accounts)
				{
					var balText = $"({FormatRupiah(acc.Balance)})";
					<option value="@acc.Id">@(acc.Icon ?? "") @acc.Name @balText</option>
				}
			</select>
		</div>

		<div class="form-group">
			<label>Tanggal</label>
			<input type="date" class="form-input" @bind="model.Date" />
		</div>

		<div class="form-group">
			<label>Catatan</label>
			<input type="text" class="form-input" @bind="model.Note" placeholder="Tambahkan catatan..." />
		</div>

		<div class="form-actions">
			<button class="btn btn-secondary" @onclick="GoBack">Batal</button>
			<button class="btn btn-primary" @onclick="SaveAsync">Simpan</button>
		</div>
	</div>
</div>

@code {
	[Parameter] public string? Type { get; set; }
	[Parameter] public int Id { get; set; }

	[Inject] private TransactionService transactionService { get; set; } = default!;
	[Inject] private CategoryService categoryService { get; set; } = default!;
	[Inject] private AccountService accountService { get; set; } = default!;
	[Inject] private NavigationManager nav { get; set; } = default!;

	private Transaction model = new();
	private List<Category> categories = new();
	private List<Account> accounts = new();
	private bool isEdit;
	private string inputAmount = "";


	protected override async Task OnInitializedAsync()
	{
		accounts = await accountService.GetAllAsync();
		isEdit = Id > 0;

		if (isEdit)
		{
			var existing = await transactionService.GetByIdAsync(Id);
			if (existing is not null)
			{
				model = existing;
				inputAmount = model.Amount.ToString("F0");
			}
		}
		else if (!string.IsNullOrEmpty(Type))
		{
			model.Type = Type;
		}

		await LoadCategoriesAsync();
	}

	private async Task LoadCategoriesAsync()
	{
		categories = await categoryService.GetByTypeAsync(model.Type);
		StateHasChanged();
	}

	private async void SetType(string type)
	{
		model.Type = type;
		model.CategoryId = null;
		await LoadCategoriesAsync();
	}

	private void GoBack() => nav.NavigateTo("/transactions");

	private async Task SaveAsync()
	{
		if (string.IsNullOrEmpty(inputAmount) || string.IsNullOrWhiteSpace(inputAmount) || !decimal.TryParse(inputAmount, out var amount))
			return;

		if (model.AccountId <= 0 || amount <= 0)
			return;

		model.Amount = amount;
		await transactionService.SaveAsync(model);
		nav.NavigateTo("/transactions");
	}

	private string FormatRupiah(decimal amount) => $"Rp{amount:N0}";
}
