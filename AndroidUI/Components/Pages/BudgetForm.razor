@page "/budgets/add"
@page "/budgets/edit/{Id:int}"
@layout MainLayout

<div class="page">
    <div class="page-header">
        <h2>@(isEdit ? "Edit" : "Tambah") Anggaran</h2>
    </div>

    <div class="form-card">
        <div class="form-group">
            <label>Kategori</label>
            <select class="form-select" @bind="model.CategoryId">
                <option value="0">Pilih kategori...</option>
                @foreach (var cat in expenseCategories)
                {
                    <option value="@cat.Id">@cat.Icon @cat.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Jumlah Anggaran</label>
            <div class="input-amount-wrapper">
                <span class="currency-prefix">Rp</span>
                <input type="number" class="form-input input-amount" @bind="amountStr"
                       placeholder="0" step="50000" />
            </div>
        </div>

        @if (!isEdit)
        {
            <div class="form-row">
                <div class="form-group">
                    <label>Bulan</label>
                    <select class="form-select" @bind="model.Month">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Tahun</label>
                    <input type="number" class="form-input" @bind="model.Year" />
                </div>
            </div>
        }

        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="GoBack">Batal</button>
            <button class="btn btn-primary" @onclick="SaveAsync">Simpan</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private BudgetService budgetService { get; set; } = default!;
    [Inject] private CategoryService categoryService { get; set; } = default!;
    [Inject] private NavigationManager nav { get; set; } = default!;

    private Budget model = new() { Month = DateTime.Now.Month, Year = DateTime.Now.Year };
    private List<Category> expenseCategories = new();
    private bool isEdit;
    private string amountStr = "";

    protected override async Task OnInitializedAsync()
    {
        isEdit = Id > 0;
        expenseCategories = await categoryService.GetByTypeAsync("Expense");

        if (isEdit)
        {
            var existing = await budgetService.GetByIdAsync(Id);
            if (existing is not null)
            {
                model = existing;
                amountStr = model.Amount.ToString("F0");
            }
        }
    }

    private void GoBack() => nav.NavigateTo("/budgets");

    private async Task SaveAsync()
    {
        if (model.CategoryId == 0 || string.IsNullOrEmpty(amountStr) || !decimal.TryParse(amountStr, out var amount))
            return;

        model.Amount = amount;
        await budgetService.SaveAsync(model);
        nav.NavigateTo("/budgets");
    }

    private string GetMonthName(int m) => new DateTime(2000, m, 1).ToString("MMMM");
}
